# =================================================================
# IBS/CBS EasyAPI - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env no desenvolvimento local: cp .env.example .env
# =================================================================

# Porta em que o servidor backend irá rodar
PORT=3001

# Ambiente de execução: development | production | test
NODE_ENV=development

# URL base da API do Piloto de Consumo da Receita Federal / SERPRO
GOV_API_BASE_URL=https://piloto-cbs.tributos.gov.br/servico/calculadora-consumo/api

# Limite do Rate Limit por IP (requisições a cada 15 minutos)
RATE_LIMIT_MAX=150
