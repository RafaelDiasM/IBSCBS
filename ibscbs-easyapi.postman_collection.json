          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/dados-abertos/ncm?ncm=24021000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dados-abertos", "ncm"],
              "query": [{ "key": "ncm", "value": "24021000" }]
            }
          }
        },
        {
          "name": "Cronograma de Transição 2026 a 2033",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/dados-abertos/cronograma",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dados-abertos", "cronograma"]
            }
          }
        }
      ]
    },
    {
      "name": "Observabilidade & Saúde da API",
      "item": [
