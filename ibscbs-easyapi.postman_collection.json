            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"/api/v1/calcular\",\n  \"method\": \"POST\",\n  \"payload\": {\n    \"valor\": 1500.0,\n    \"ncm\": \"24021000\",\n    \"ufDestino\": \"SP\",\n    \"municipioDestino\": 3550308,\n    \"data\": \"2027-01-01\"\n  }\n}"
